+    return { ...row, value, text: [row.label, value].filter(Boolean).join(' ') };
+  });
+  if (!rows.length) return null;
+  const text = rows.map(row => row.text).join(' · ');
+  return { type, rows, text, key: JSON.stringify([scene, type, rows]) };
